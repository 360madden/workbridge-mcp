<Window x:Class="Workbridge.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workbridge Control Center" Width="900" Height="740"
        MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <TextBlock Text="Workbridge Control Center" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Live local engine monitoring · Read-only" Margin="0,8,0,0" Foreground="Gray"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Padding="16" CornerRadius="8" Background="#FFEAEFF4">
          <StackPanel>
            <TextBlock Text="Engine connection" FontWeight="Bold"/>
            <TextBlock x:Name="ConnectionText" Text="Connecting..." Margin="0,8,0,0"/>
            <TextBlock x:Name="VersionText" Text="Version: —" Margin="0,8,0,0"/>
            <TextBlock x:Name="CapacityText" Text="Slots: —" Margin="0,8,0,0"/>
            <TextBlock x:Name="JobsText" Text="Running jobs: —" Margin="0,8,0,0"/>
            <TextBlock x:Name="SampleText" Text="Last sample: —" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock Text="Active and retained command jobs" FontWeight="Bold" Margin="0,20,0,8"/>
        <TextBlock x:Name="InventoryText" Text="Inventory: —" Foreground="Gray"/>
        <ListBox x:Name="JobList" Height="160" Margin="0,8,0,0"/>
        <Button x:Name="DetailsButton" Content="View selected job details" Width="200"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="DetailsButton_Click"/>
        <TextBlock Text="Selected job details · Output is limited to the latest 4,000 characters"
                   FontWeight="Bold" Margin="0,16,0,8"/>
        <TextBox x:Name="DetailsText" Text="Select a job and choose View selected job details."
                 Height="170" IsReadOnly="True" TextWrapping="Wrap"
                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
        <TextBlock Text="Job output can include secrets from local commands; it is displayed only in this window."
                   Margin="0,10,0,0" Foreground="Gray" TextWrapping="Wrap"/>
        <TextBlock Text="Closing this window hides it to the system tray. Workbridge runs independently."
                   Margin="0,16,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
