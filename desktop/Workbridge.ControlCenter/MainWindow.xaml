<Window x:Class="Workbridge.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workbridge Control Center" Width="860" Height="560"
        MinWidth="600" MinHeight="400" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <TextBlock Text="Workbridge Control Center" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Desktop shell · Live MCP integration is the next milestone" Margin="0,8,0,0" Foreground="Gray"/>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Padding="16" CornerRadius="8" Background="#FFEAEFF4">
        <StackPanel>
          <TextBlock Text="Engine connection" FontWeight="Bold"/>
          <TextBlock Text="Not connected — desktop shell only" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="1" Text="Workbridge continues independently when this window is hidden or closed."
                 VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
  </DockPanel>
</Window>
