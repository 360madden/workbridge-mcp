{
  "name": "workbridge-mcp",
  "version": "0.6.0",
  "private": true,
  "description": "Small Windows coding bridge for browser ChatGPT via Secure MCP Tunnel",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && node scripts/build-command-host.mjs",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:startup": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File test/startup.test.ps1",
    "test:updater": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File test/updater.test.ps1",
    "acceptance:release": "node scripts/release-acceptance.mjs",
    "check": "npm test",
    "acceptance": "npm run build && node scripts/acceptance.mjs",
    "format": "prettier --write src test scripts/*.mjs package.json .prettierrc.json",
    "format:check": "prettier --check src test scripts/*.mjs package.json .prettierrc.json",
    "acceptance:project": "npm run build && node scripts/acceptance-project.mjs",
    "acceptance:snapshot": "npm run build && node scripts/snapshot-acceptance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@vscode/ripgrep": "1.18.0",
    "diff": "9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
